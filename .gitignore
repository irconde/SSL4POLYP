# Experiment artefacts (allow documentation of layout)
/checkpoints/*
!/checkpoints/.gitignore
!/checkpoints/README.md

/data/*
!/data/.gitignore
!/data/README.md
!/data/roots.example.json

/outputs/*
!/outputs/.gitignore
!/outputs/README.md

/results/*
!/results/.gitignore
!/results/README.md

# Campaign v3: weights and run outputs stay local; the run log, environment record and
# verification summaries are versioned.
/checkpoints_v3/
/results_v3/*
!/results_v3/RUNLOG.md
!/results_v3/environment/
!/results_v3/verification/
!/results_v3/SAP_deviations.md

# Python cache and virtual environment files
__pycache__/
*.py[cod]
*$py.class
.venv/
.env/
.DS_Store

# Build metadata from pip install -e
*.egg-info/
